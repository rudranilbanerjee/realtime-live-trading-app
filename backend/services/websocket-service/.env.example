# WebSocket Service (users / frontend connect here)
# Run several copies with different PORT and INSTANCE_ID: ws-1 -> 3004, ws-2 -> 3005, ws-3 -> 3006
NODE_ENV=development
PORT=3004
INSTANCE_ID=ws-1

# WebSocket URL of event-distribution-service (this server subscribes to market events)
# Docker: ws://event-distribution-service:3003
EVENT_DISTRIBUTION_WS_URL=ws://localhost:3003

# Allowed frontend origin (Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
